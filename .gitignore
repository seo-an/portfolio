# Python-generated files and local environments
__pycache__/
*.py[cod]
.venv/
.venv-*/
venv/
.DS_Store

# No actual input/output, employee data, run logs, or credentials in Git.
/bhandara/data/**
!/bhandara/data/.gitkeep
.env
.env.*
*.pem
*.key
*.p12
*.pfx

# Local external source clones never belong in this repository.
/.external/
