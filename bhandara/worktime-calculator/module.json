{
  "schema_version": "1.0",
  "module_id": "worktime-calculator",
  "module_version": "0.3.0",
  "status": "review_only",
  "requires_base": "0.1",
  "python": ">=3.12",
  "dependencies": {
    "openpyxl": "3.1.5"
  },
  "execution": {
    "command": "python run.py bhandara worktime-calculator --normalized <normalized-input.json> --config <worktime-config.json> --output-dir <new-output-dir>",
    "network_access": false,
    "requires_authentication": false,
    "source_contract": "canonical normalized-input.json from external source-mapping 0.1"
  },
  "inputs": [
    {
      "key": "normalized",
      "required": true,
      "type": "json",
      "schema_version": "0.1",
      "note": "Canonical normalized-input.json (employees/schedule/attendance + lineage). No raw Excel parsing by this module."
    },
    {
      "key": "config",
      "required": true,
      "type": "json",
      "schema_version": "0.1"
    }
  ],
  "output_files": [
    "worktime-result.json",
    "worktime-review.json",
    "worktime-review.xlsx"
  ],
  "exit_codes": {
    "0": "CALCULATED_UNCLOSED",
    "2": "REVIEW_REQUIRED/BLOCKED/invalid input"
  },
  "non_finalization_guards": {
    "finalizable": false,
    "coverage_verified": false,
    "close_receipt": null
  },
  "migration_manifest": "migration-manifest.json",
  "limitations": [
    "Original direct JSON and Worktime core functions unchanged; optional shared Excel bridge validates external participants, not approval or source-normalizer semantics",
    "No approval, period close, or payroll finalization",
    "Original functions and standalone CLI are copied without logic edits"
  ],
  "shared_excel_input": {
    "supported": true,
    "default_root": "bhandara/data/input",
    "common_roles": {
      "employees": "common/employee.xlsx",
      "identity": "common/id-map.xlsx"
    },
    "roles": {
      "schedule": "worktime/work-schedule.xlsx",
      "attendance": "worktime/attendance.xlsx"
    },
    "monthly_files": [],
    "default_period_option": "--period YYYY-MM",
    "advanced_overrides": "--paths-config JSON role map",
    "note": "Fixed paths are defaults. Old explicit JSON/normalized CLI modes remain supported.",
    "external_workers": {
      "optional": true,
      "identity_book": "common/id-map.xlsx",
      "employee_sheet": "ID_MAP",
      "external_sheet": "EXTERNAL",
      "external_columns": [
        "worker_id",
        "security_id"
      ],
      "employee_columns": "employee_id only, worker_id blank/absent",
      "external_record_columns": "employee_id blank, worker_id required",
      "applies_to": [
        "worktime/work-schedule.xlsx",
        "worktime/attendance.xlsx"
      ],
      "provenance": "source_hashes.identity_map (SHA-256 of entire common/id-map.xlsx)",
      "legal_status": "REVIEW_ONLY; identity mapping does not infer employment or vendor withholding",
      "payroll_integration": "external worker_id in pay-contract.xlsx Contracts; no service-specific work-record file"
    }
  }
}
