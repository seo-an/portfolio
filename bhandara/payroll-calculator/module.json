{
  "schema_version": "1.0",
  "module_id": "payroll-calculator",
  "module_version": "0.3.0",
  "status": "review_only",
  "requires_base": "0.1",
  "python": ">=3.12",
  "dependencies": {
    "openpyxl": "3.1.5"
  },
  "execution": {
    "calculate": "python run.py bhandara payroll-calculator --config <payroll-config.json> --output-dir <new-private-output>",
    "normalize": "python run.py bhandara payroll-calculator --operation normalize --input-dir <raw-input> --output-dir <new-private-output>",
    "network_access": false,
    "requires_authentication": false
  },
  "source_contract": "Original Gearbox Payroll standalone CLI 0.1 with optional existing Worktime result / rows / approved close receipts; not an approved payment or settlement process.",
  "output_files": {
    "calculate_success": [
      "payroll-calculation.json",
      "payroll-calculation.xlsx",
      "payroll-review.json",
      "payroll-review.xlsx",
      "policy-resolution.json",
      "contract-basis-review.json",
      "contract-basis-review.xlsx",
      "contract-derived-compensation.xlsx"
    ],
    "calculate_blocked": [
      "payroll-review.json",
      "payroll-review.xlsx"
    ]
  },
  "exit_codes": {
    "calculate": 2,
    "normalize_clean": 0,
    "normalize_review_or_error": 2
  },
  "non_finalization_guards": {
    "finalizable": false,
    "ledger_committed": false
  },
  "migration_manifest": "migration-manifest.json",
  "limitations": [
    "No worktime close or payroll payment approval",
    "Runtime source registry and policy are copied from the existing Gearbox snapshot",
    "Existing Gearbox operations and workflows remain unchanged",
    "Contract wage mode calculates annual/monthly base salary and hourly/daily ordinary base pay from the separately reviewed Worktime source; employee hourly/daily premiums and paid weekly holidays are flagged but not calculated.",
    "Freelance service contracts are isolated for review, excluded from employee payroll; no tax or withholding decision is inferred."
  ],
  "shared_excel_input": {
    "supported": true,
    "default_root": "bhandara/data/input",
    "common_roles": {
      "employees": "common/employee.xlsx",
      "identity": "common/id-map.xlsx"
    },
    "roles": {
      "contracts": "payroll/pay-contract.xlsx",
      "contract_components": "payroll/pay-contract-components.xlsx",
      "service_contracts": "payroll/service-contracts.xlsx",
      "compensation": "payroll/compensation.xlsx",
      "payroll_input": "payroll/payroll-input.xlsx",
      "company_policy": "payroll/company-policy.json",
      "worktime_result": "payroll/worktime-result.json",
      "service_records": "payroll/service-work-records.xlsx"
    },
    "monthly_files": [],
    "default_period_option": "--period YYYY-MM",
    "advanced_overrides": "--paths-config JSON role map",
    "note": "New pay-contract.xlsx mode derives base salary and produces audited REVIEW_REQUIRED results; legacy compensation.xlsx remains a fallback if no contract file is present.",
    "contract_semantics": {
      "basis": [
        "ANNUAL",
        "MONTHLY",
        "HOURLY",
        "DAILY"
      ],
      "included_components": [
        "position_allowance",
        "meal_allowance"
      ],
      "service_optional": true,
      "not_calculated": [
        "hourly_daily_premium",
        "weekly_paid_holiday",
        "service_contract_settlement",
        "statutory_tax_and_insurance"
      ],
      "service_records_optional": true,
      "service_estimates": "hourly/daily contract rate multiplied by separately evidenced quantity, review only"
    }
  }
}
