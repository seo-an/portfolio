{
  "schema_version": "1.0",
  "module_id": "payroll-calculator",
  "module_version": "0.2.0",
  "status": "review_only",
  "requires_base": "0.1",
  "python": ">=3.12",
  "dependencies": {
    "openpyxl": "3.1.5"
  },
  "execution": {
    "calculate": "python run.py bhandara payroll-calculator --config <payroll-config.json> --output-dir <new-private-output>",
    "normalize": "python run.py bhandara payroll-calculator --operation normalize --input-dir <raw-input> --output-dir <new-private-output>",
    "network_access": false,
    "requires_authentication": false
  },
  "source_contract": "Original Gearbox Payroll standalone CLI 0.1 with optional existing Worktime result / rows / approved close receipts; not an approved payment or settlement process.",
  "output_files": {
    "calculate_success": [
      "payroll-calculation.json",
      "payroll-calculation.xlsx",
      "payroll-review.json",
      "payroll-review.xlsx",
      "policy-resolution.json"
    ],
    "calculate_blocked": [
      "payroll-review.json",
      "payroll-review.xlsx"
    ]
  },
  "exit_codes": {
    "calculate": 2,
    "normalize_clean": 0,
    "normalize_review_or_error": 2
  },
  "non_finalization_guards": {
    "finalizable": false,
    "ledger_committed": false
  },
  "migration_manifest": "migration-manifest.json",
  "limitations": [
    "No calculation, policy or error-handling improvements in this migration",
    "No worktime close or payroll payment approval",
    "Runtime source registry and policy are copied from the existing Gearbox snapshot",
    "Existing Gearbox operations and workflows remain unchanged"
  ],
  "shared_excel_input": {
    "supported": true,
    "default_root": "bhandara/data/input",
    "common_roles": {
      "employees": "common/employee.xlsx",
      "identity": "common/id-map.xlsx"
    },
    "roles": {
      "compensation": "payroll/compensation.xlsx",
      "payroll_input": "payroll/payroll-input.xlsx",
      "company_policy": "payroll/company-policy.json",
      "worktime_result": "payroll/worktime-result.json"
    },
    "monthly_files": [],
    "default_period_option": "--period YYYY-MM",
    "advanced_overrides": "--paths-config JSON role map",
    "note": "Fixed paths are defaults. Old explicit JSON/normalized CLI modes remain supported."
  }
}
