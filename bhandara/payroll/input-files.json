{
  "schema_version": "1.0",
  "tool": "payroll",
  "status": "READER_IMPLEMENTED_NOT_YET_CONNECTED_TO_CLI",
  "input_directory": "payroll",
  "note": "Seven independent one-sheet workbooks. Runtime inputs are under input_root/payroll; public synthetic samples live separately in bhandara/examples/sample/input/payroll. Binary XLSX files are not committed in this PR.",
  "workbooks": {
    "contracts": {
      "filename": "pay-contract.xlsx",
      "sheet": "CONTRACTS",
      "columns": [
        "employee_id",
        "contract_id",
        "pay_basis",
        "contract_amount",
        "amount_type",
        "installments_per_year",
        "declared_base_amount",
        "daily_base_rate",
        "deduction_code",
        "calculation_period_from",
        "calculation_period_to",
        "payment_date"
      ]
    },
    "allowance_assignments": {
      "filename": "allowance-assignments.xlsx",
      "sheet": "ALLOWANCE ASSIGNMENTS",
      "columns": [
        "contract_id",
        "allowance_id",
        "level"
      ]
    },
    "fixed_allowance_map": {
      "filename": "fixed-allowance-map.xlsx",
      "sheet": "FIXED ALLOWANCE MAP",
      "columns": [
        "allowance_id",
        "level",
        "amount",
        "payroll_taxability",
        "taxability_policy_ref"
      ]
    },
    "deduction_map": {
      "filename": "deduction-map.xlsx",
      "sheet": "DEDUCTION MAP",
      "columns": [
        "deduction_code",
        "national_pension",
        "health_insurance",
        "longterm_care",
        "employment_insurance",
        "effective_from",
        "effective_to",
        "source_ref"
      ]
    },
    "overtime_rules": {
      "filename": "overtime-rules.xlsx",
      "sheet": "OVERTIME RULES",
      "columns": [
        "rule_id",
        "category",
        "qualifying_from",
        "qualifying_to",
        "minimum_minutes",
        "daily_rate_multiplier",
        "policy_ref"
      ]
    },
    "bonus_budget": {
      "filename": "bonus-budget.xlsx",
      "sheet": "BONUS BUDGET",
      "columns": [
        "bonus_id",
        "team_id",
        "project_id",
        "budget_amount"
      ]
    },
    "bonus_allocation": {
      "filename": "bonus-allocation.xlsx",
      "sheet": "BONUS ALLOCATION",
      "columns": [
        "bonus_id",
        "employee_id",
        "allocation_ratio"
      ]
    }
  },
  "sample_directory": "bhandara/examples/sample/input/payroll"
}
